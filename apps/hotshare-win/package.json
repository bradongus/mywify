{
  "name": "hotshare-win",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder --win",
    "build:dir": "tsc && electron-builder --win --dir",
    "start": "electron ."
  },
  "dependencies": {
    "@hotshare/shared-core": "file:../../packages/shared-core",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "electron": "35.7.5",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.hotshare.win",
    "productName": "hotshare",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "dist/**/*",
      "csharp/**/*"
    ],
    "extraResources": [
      {
        "from": "csharp/",
        "to": "csharp/"
      }
    ],
    "electronDist": "../../node_modules/electron/dist"
  }
}
