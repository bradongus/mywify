{
  "name": "hotshare-win",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "description": "Turn any PC or phone into a WiFi hotspot with voucher-based client access.",
  "author": {
    "name": "hotshare",
    "email": "noreply@github.com"
  },
  "homepage": "https://github.com/bradongus/mywify",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder --win",
    "build:dir": "tsc && electron-builder --win --dir",
    "start": "electron ."
  },
  "dependencies": {
    "@hotshare/shared-core": "file:../../packages/shared-core",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "electron": "35.7.5",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.hotshare.win",
    "productName": "hotshare",
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "src/renderer/public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "csharp/publish/",
          "to": "csharp/"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "hotshare <noreply@github.com>",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png"
    },
    "electronDist": "../../node_modules/electron/dist"
  }
}
